{
    "name": "Epic The Musical - Community Editon",
    "description": "An Epic the Musical GX mod made by the community of Epic The Musical. This mod includes a custom theme, wallpaper, splash screen, and background music. The Source code for this mod is available on GitHub at https://github.com/hrty1/Epic-The-Musical-GX-Mod-Community-Edition",
    "developer":
    {
        "name": "The community of Epic The Musical"
    },
    "icons": {
      "512": "icon_512.png"
    },
    "manifest_version": 3,
    "mod":
    {
        "license": "license.txt",
        "payload":
        {
            "background_music": [ {
            "id": "0",
            "name": "Epic",
            "tracks": [ "music/full_song.mp3" ]
            } ],
            "page_styles": [ {
            "id": "page_styles_01",
            "name": "Epic",
            "css": [ "webmodding/epic-fonts.css" ],
            "matches": [ "*://*/*" ] } ],
            "splash_screen": [ {
            "id": "splash_screen_01",
            "name": "Epic",
            "path": "splash/splash1.mp4" } ],
            
            "theme": [ {
            "id": "theme_01",
            "name": "Epic",
            "dark": {
               "gx_accent": {
                  "h": 355,
                  "l": 36,
                  "s": 95
               },
               "gx_secondary_base": {
                  "h": 350,
                  "l": 8,
                  "s": 30
               }
            },
            "light": {
               "gx_accent": {
                  "h": 355,
                  "l": 45,
                  "s": 85
               },
               "gx_secondary_base": {
                  "h": 350,
                  "l": 90,
                  "s": 22
               }
            }
         } ],
            "wallpaper": [ {
            "id": "wallpaper_01",
            "name": "Epic",
            "dark": {
               "image": "wallpaper/dark.png",
               "text_color": "#FFFFFF",
               "text_shadow": "#1A0000"
            },
            "light": {
               "image": "wallpaper/light.png",
               "text_color": "#FFFFFF",
               "text_shadow": "#1A0000"
            }
         } ]
        },
        "schema_version": 2
    },
    "version": "1.0"
}
